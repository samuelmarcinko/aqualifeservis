# ---------------------------------------------------------------------------
# AQUALIFE SERVIS – Evidencia — environment variables
# Copy to .env (local) or set in the Vercel project settings.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (Neon or any Vercel-compatible managed Postgres).
# Use a pooled connection string for the app; a direct one for migrations.
DATABASE_URL="postgresql://user:password@host:5432/aqualife?sslmode=require"

# BetterAuth
# Generate a strong secret, e.g.:  openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL of the app (used by the auth client and email links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob (persistent storage for photos and generated PDFs).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Server-side encryption key for sensitive settings (SMTP password).
# Must be at least 16 characters. Generate:  openssl rand -base64 32
APP_ENCRYPTION_KEY="change-me-to-a-long-random-key"

# Initial SUPER_ADMIN account (used by `npm run db:seed`).
INITIAL_SUPER_ADMIN_EMAIL="admin@aqualife.sk"
INITIAL_SUPER_ADMIN_PASSWORD="ChangeMe-Str0ngPassword"
INITIAL_SUPER_ADMIN_NAME="Super Administrátor"
